&CONTROL
 calculation = 'md'
 restart_mode='from_scratch',
 prefix='BGDY__T1000K',
 pseudo_dir = './',
 outdir='./save',
 dt=20.d0
 tprnfor = .true.,
 tstress = .true.,
 iprint = 1,
 nstep=1000
/
&SYSTEM
 ibrav=0,
 nat=55,
 ntyp=2,
 nspin=2,
 starting_magnetization(1)=0.1d0,
 starting_magnetization(2)=0.1d0,	 
 ecutwfc=60.0, ecutrho=600.0,
 vdw_corr="Grimme-D3",
 occupations = 'smearing',
 smearing = 'gaussian',
 degauss = 0.005,
 nosym = .true.,
/
&ELECTRONS
 electron_maxstep=250
 mixing_mode = 'plain'
 mixing_beta = 0.2
 conv_thr = 7.35d-6
/
&IONS
 ion_dynamics = 'verlet',
 ion_temperature = 'nose',
 fnosep=20.0,
 tempw = 1000.0,
/
